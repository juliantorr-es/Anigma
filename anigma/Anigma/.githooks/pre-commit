#!/bin/bash
#
# Pre-commit hook for Anigma build hygiene validation
# Install with: git config core.hooksPath .githooks
#

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

echo -e "${YELLOW}=== Anigma Build Hygiene Pre-Commit Check ===${NC}"
echo ""

# Run build hygiene validation
if [ -f "$REPO_ROOT/scripts/validate_build_hygiene.sh" ]; then
    echo -e "${YELLOW}Running build hygiene validation...${NC}"
    
    if bash "$REPO_ROOT/scripts/validate_build_hygiene.sh"; then
        echo -e "${GREEN}✓ Build hygiene check passed${NC}"
    else
        echo -e "${RED}✗ Build hygiene check failed${NC}"
        echo ""
        echo "To bypass this check (not recommended):"
        echo "  git commit --no-verify"
        echo ""
        echo "Or fix the issues by:"
        echo "  1. Adding DEPS.toml to packages with native code"
        echo "  2. Adding EXTERNAL_DEP/REASON/BUILD_ENV comments"
        echo "  3. Removing hardcoded /opt/homebrew paths"
        echo ""
        exit 1
    fi
else
    echo -e "${YELLOW}⚠ Build hygiene script not found${NC}"
fi

echo -e "${GREEN}✓ Pre-commit checks passed${NC}"
exit 0
