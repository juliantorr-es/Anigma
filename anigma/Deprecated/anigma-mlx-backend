#!/usr/bin/env swift

import Foundation
import CryptoKit

/// Anigma MLX Backend Wrapper - provides stable CLI contract for MLX models
/// 
/// Usage: anigma-mlx-backend embed --model <path> --input <path> --output <path> [options]
///        anigma-mlx-backend chat --model <path> --input <path> --output <path> [options]

struct MLXBackendConfig {
    let modelPath: String
    let task: String
    let inputPath: String  
    let outputPath: String
    let dims: Int?
    let pooling: String?
    let normalize: Bool
    let seed: Int
    let maxTokens: Int?
    let temperature: Double?
    let topP: Double?
}

func parseArgs() -> MLXBackendConfig? {
    let args = CommandLine.arguments
    
    guard args.count >= 6 else {
        fputs("Usage: anigma-mlx-backend <task> --model <path> --input <path> --output <path> [options]\n", stderr)
        fputs("Tasks: embed, chat\n", stderr)
        fputs("Options:\n", stderr)
        fputs("  --dims <int>        Expected embedding dimensions (embed only)\n", stderr)
        fputs("  --pooling <method>  Pooling strategy: mean, cls (embed only)\n", stderr)
        fputs("  --normalize <0|1>   Normalize embeddings (embed only)\n", stderr)
        fputs("  --max-tokens <int>  Maximum tokens to generate (chat only)\n", stderr)
        fputs("  --temperature <float> Sampling temperature (chat only)\n", stderr)
        fputs("  --top-p <float>     Top-p sampling (chat only)\n", stderr)
        fputs("  --seed <int>        Random seed\n", stderr)
        return nil
    }
    
    guard args.count > 1 else { return nil }
    let task = args[1]
    guard task == "embed" || task == "chat" else {
        fputs("Error: task must be 'embed' or 'chat'\n", stderr)
        return nil
    }
    
    var config = MLXBackendConfig(
        modelPath: "",
        task: task,
        inputPath: "",
        outputPath: "",
        dims: nil,
        pooling: nil,
        normalize: true,
        seed: 42,
        maxTokens: nil,
        temperature: nil,
        topP: nil
    )
    
    var i = 2
    while i < args.count {
        switch args[i] {
        case "--model":
            guard i + 1 < args.count else { return nil }
            config = MLXBackendConfig(
                modelPath: args[i + 1],
                task: config.task,
                inputPath: config.inputPath,
                outputPath: config.outputPath,
                dims: config.dims,
                pooling: config.pooling,
                normalize: config.normalize,
                seed: config.seed,
                maxTokens: config.maxTokens,
                temperature: config.temperature,
                topP: config.topP
            )
            i += 2
        case "--input":
            guard i + 1 < args.count else { return nil }
            config = MLXBackendConfig(
                modelPath: config.modelPath,
                task: config.task,
                inputPath: args[i + 1],
                outputPath: config.outputPath,
                dims: config.dims,
                pooling: config.pooling,
                normalize: config.normalize,
                seed: config.seed,
                maxTokens: config.maxTokens,
                temperature: config.temperature,
                topP: config.topP
            )
            i += 2
        case "--output":
            guard i + 1 < args.count else { return nil }
            config = MLXBackendConfig(
                modelPath: config.modelPath,
                task: config.task,
                inputPath: config.inputPath,
                outputPath: args[i + 1],
                dims: config.dims,
                pooling: config.pooling,
                normalize: config.normalize,
                seed: config.seed,
                maxTokens: config.maxTokens,
                temperature: config.temperature,
                topP: config.topP
            )
            i += 2
        case "--dims":
            guard i + 1 < args.count, let dims = Int(args[i + 1]) else { return nil }
            config = MLXBackendConfig(
                modelPath: config.modelPath,
                task: config.task,
                inputPath: config.inputPath,
                outputPath: config.outputPath,
                dims: dims,
                pooling: config.pooling,
                normalize: config.normalize,
                seed: config.seed,
                maxTokens: config.maxTokens,
                temperature: config.temperature,
                topP: config.topP
            )
            i += 2
        case "--pooling":
            guard i + 1 < args.count else { return nil }
            config = MLXBackendConfig(
                modelPath: config.modelPath,
                task: config.task,
                inputPath: config.inputPath,
                outputPath: config.outputPath,
                dims: config.dims,
                pooling: args[i + 1],
                normalize: config.normalize,
                seed: config.seed,
                maxTokens: config.maxTokens,
                temperature: config.temperature,
                topP: config.topP
            )
            i += 2
        case "--normalize":
            guard i + 1 < args.count, let normalize = Int(args[i + 1]) else { return nil }
            config = MLXBackendConfig(
                modelPath: config.modelPath,
                task: config.task,
                inputPath: config.inputPath,
                outputPath: config.outputPath,
                dims: config.dims,
                pooling: config.pooling,
                normalize: normalize != 0,
                seed: config.seed,
                maxTokens: config.maxTokens,
                temperature: config.temperature,
                topP: config.topP
            )
            i += 2
        case "--seed":
            guard i + 1 < args.count, let seed = Int(args[i + 1]) else { return nil }
            config = MLXBackendConfig(
                modelPath: config.modelPath,
                task: config.task,
                inputPath: config.inputPath,
                outputPath: config.outputPath,
                dims: config.dims,
                pooling: config.pooling,
                normalize: config.normalize,
                seed: seed,
                maxTokens: config.maxTokens,
                temperature: config.temperature,
                topP: config.topP
            )
            i += 2
        case "--max-tokens":
            guard i + 1 < args.count, let maxTokens = Int(args[i + 1]) else { return nil }
            config = MLXBackendConfig(
                modelPath: config.modelPath,
                task: config.task,
                inputPath: config.inputPath,
                outputPath: config.outputPath,
                dims: config.dims,
                pooling: config.pooling,
                normalize: config.normalize,
                seed: config.seed,
                maxTokens: maxTokens,
                temperature: config.temperature,
                topP: config.topP
            )
            i += 2
        case "--temperature":
            guard i + 1 < args.count, let temperature = Double(args[i + 1]) else { return nil }
            config = MLXBackendConfig(
                modelPath: config.modelPath,
                task: config.task,
                inputPath: config.inputPath,
                outputPath: config.outputPath,
                dims: config.dims,
                pooling: config.pooling,
                normalize: config.normalize,
                seed: config.seed,
                maxTokens: config.maxTokens,
                temperature: temperature,
                topP: config.topP
            )
            i += 2
        case "--top-p":
            guard i + 1 < args.count, let topP = Double(args[i + 1]) else { return nil }
            config = MLXBackendConfig(
                modelPath: config.modelPath,
                task: config.task,
                inputPath: config.inputPath,
                outputPath: config.outputPath,
                dims: config.dims,
                pooling: config.pooling,
                normalize: config.normalize,
                seed: config.seed,
                maxTokens: config.maxTokens,
                temperature: config.temperature,
                topP: topP
            )
            i += 2
        default:
            fputs("Error: Unknown argument \(args[i])\n", stderr)
            return nil
        }
    }
    
    // Validate required arguments
    guard !config.modelPath.isEmpty, !config.inputPath.isEmpty, !config.outputPath.isEmpty else {
        fputs("Error: --model, --input, and --output are required\n", stderr)
        return nil
    }
    
    return config
}

func generateMockEmbedding(config: MLXBackendConfig) throws {
    // For now, generate deterministic mock embeddings
    // In production, this would call actual MLX APIs
    
    let dims = config.dims ?? 384
    let inputData = try Data(contentsOf: URL(fileURLWithPath: config.inputPath))
    let inputText = String(data: inputData, encoding: .utf8) ?? ""
    
    // Generate deterministic embedding based on input and seed
    var embeddingData = Data()
    var hasher = SHA256()
    hasher.update(data: inputData)
    hasher.update(data: Data("\(config.seed)".utf8))
    
    for i in 0..<dims {
        hasher.update(data: Data([UInt8(i % 256)]))
        let digest = hasher.finalize()
        let digestData = Data(digest)
        let byteValue = Double(digestData[0])
        let normalizedValue = (byteValue / 255.0) * 2.0 - 1.0
        let value = Float(normalizedValue) // Normalize to [-1, 1]
        
        var little = value.bitPattern.littleEndian
        embeddingData.append(contentsOf: withUnsafeBytes(of: &little) { Data($0) })
        
        // Reset hasher for next iteration
        hasher = SHA256()
        hasher.update(data: inputData)
        hasher.update(data: Data("\(config.seed + i)".utf8))
    }
    
    // Apply normalization if requested
    if config.normalize {
        // L2 normalization
        var sum: Float = 0
        let floatData = embeddingData.withUnsafeBytes { pointer in
            Array(pointer.bindMemory(to: Float.self))
        }
        
        for value in floatData {
            sum += value * value
        }
        let norm = sqrt(sum)
        
        if norm > 0 {
            var normalizedData = Data()
            for value in floatData {
                let normalized = value / norm
                var little = normalized.bitPattern.littleEndian
                normalizedData.append(contentsOf: withUnsafeBytes(of: &little) { Data($0) })
            }
            embeddingData = normalizedData
        }
    }
    
    try embeddingData.write(to: URL(fileURLWithPath: config.outputPath))
    
    // Output minimal JSON summary to stdout
    let summary = [
        "task": config.task,
        "dims": dims,
        "pooling": config.pooling ?? "mean",
        "normalized": config.normalize,
        "input_length": inputText.count
    ] as [String : Any]
    
    let jsonData = try JSONSerialization.data(withJSONObject: summary, options: [.sortedKeys])
    FileHandle.standardOutput.write(jsonData)
}

func generateMockChat(config: MLXBackendConfig) throws {
    let inputData = try Data(contentsOf: URL(fileURLWithPath: config.inputPath))
    let inputText = String(data: inputData, encoding: .utf8) ?? ""
    
    // Generate deterministic mock response
    let response = "MLX response to: \(String(inputText.prefix(200))) (seed: \(config.seed))"
    try response.write(to: URL(fileURLWithPath: config.outputPath), atomically: true, encoding: .utf8)
    
    // Output minimal JSON summary to stdout
    let summary = [
        "task": config.task,
        "input_length": inputText.count,
        "output_length": response.count,
        "seed": config.seed
    ] as [String : Any]
    
    let jsonData = try JSONSerialization.data(withJSONObject: summary, options: [.sortedKeys])
    FileHandle.standardOutput.write(jsonData)
}

// Main execution
guard let config = parseArgs() else {
    exit(1)
}

// Validate input file exists
guard FileManager.default.fileExists(atPath: config.inputPath) else {
    fputs("Error: Input file does not exist: \(config.inputPath)\n", stderr)
    exit(1)
}

// Validate model path exists
guard FileManager.default.fileExists(atPath: config.modelPath) else {
    fputs("Error: Model path does not exist: \(config.modelPath)\n", stderr)
    exit(1)
}

do {
    switch config.task {
    case "embed":
        try generateMockEmbedding(config: config)
    case "chat":
        try generateMockChat(config: config)
    default:
        fputs("Error: Unsupported task: \(config.task)\n", stderr)
        exit(1)
    }
} catch {
    fputs("Error: \(error)\n", stderr)
    exit(1)
}