#!/bin/bash

# Anigma Offline Verification Tool
# Air-gapped verification of evidence bundles without trusting Anigma servers

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VERIFICATION_VERSION="1.0.0"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m'

# Help function
show_help() {
    cat << EOF
🔍 Anigma Offline Verification Tool

USAGE:
    anigma-verify <bundle-path> [options]

This tool provides complete offline verification of Anigma evidence bundles
without requiring network access or trust in Anigma infrastructure.

VERIFICATION STEPS:
    1. Bundle integrity - Verify manifest and file hashes
    2. Evidence chain - Verify hash chain linkage
    3. Digital signatures - Verify cryptographic signatures
    4. Timestamp tokens - Verify external timestamps (RFC3161, NIST Beacon)
    5. Key custody - Verify key status and revocation lists
    6. Hardware attestations - Verify Secure Enclave/TPM attestations
    7. Redaction audit trail - Verify redaction integrity and privilege logs

OPTIONS:
    --strict                Fail on any warning
    --skip-timestamps       Skip external timestamp verification
    --skip-attestations     Skip hardware attestation verification
    --revocation-list <file> Use custom revocation list
    --trust-anchors <dir>   Directory of trusted root certificates
    --output <file>         Save detailed verification report
    --format <format>       Report format: json, html, txt (default: txt)
    --verbose               Show detailed verification steps
    --quiet                 Only show final result

EXAMPLES:
    # Standard verification
    anigma-verify ./evidence-bundle-20241213/

    # Strict verification with custom trust anchors
    anigma-verify ./bundle/ --strict --trust-anchors ./certs/

    # Verification for air-gapped environment
    anigma-verify ./bundle/ --skip-timestamps --output report.txt

REQUIREMENTS:
    - sqlite3 (for database operations)
    - openssl (for cryptographic verification)
    - jq (for JSON processing)
    - sha256sum (for hash verification)

This tool ensures that evidence bundles remain verifiable even when
Anigma infrastructure is unavailable or compromised.

EOF
}

# Print functions
print_status() {
    echo -e "${BLUE}🔍 $1${NC}"
}

print_success() {
    echo -e "${GREEN}✅ $1${NC}"
}

print_warning() {
    echo -e "${YELLOW}⚠️  $1${NC}"
}

print_error() {
    echo -e "${RED}❌ $1${NC}"
}

print_header() {
    echo -e "${PURPLE}🔍 Anigma Offline Verification v$VERIFICATION_VERSION${NC}"
    echo -e "${PURPLE}==============================================${NC}"
}

# Verification result tracking
VERIFICATION_PASSED=true
VERIFICATION_WARNINGS=0
VERIFICATION_ERRORS=0
VERIFICATION_STEPS=()

# Add verification step
add_step() {
    local step_name="$1"
    local result="$2"
    local message="$3"
    
    VERIFICATION_STEPS+=("$step_name|$result|$message")
    
    case "$result" in
        "PASS")
            print_success "$step_name: $message"
            ;;
        "WARN")
            print_warning "$step_name: $message"
            VERIFICATION_WARNINGS=$((VERIFICATION_WARNINGS + 1))
            if [ "$STRICT_MODE" = true ]; then
                VERIFICATION_PASSED=false
            fi
            ;;
        "FAIL")
            print_error "$step_name: $message"
            VERIFICATION_ERRORS=$((VERIFICATION_ERRORS + 1))
            VERIFICATION_PASSED=false
            ;;
    esac
}

# Check dependencies
check_dependencies() {
    local missing_deps=()
    
    if ! command -v sqlite3 >/dev/null 2>&1; then
        missing_deps+=("sqlite3")
    fi
    
    if ! command -v openssl >/dev/null 2>&1; then
        missing_deps+=("openssl")
    fi
    
    if ! command -v jq >/dev/null 2>&1; then
        missing_deps+=("jq")
    fi
    
    if ! command -v sha256sum >/dev/null 2>&1; then
        missing_deps+=("sha256sum")
    fi
    
    if [ ${#missing_deps[@]} -ne 0 ]; then
        print_error "Missing dependencies: ${missing_deps[*]}"
        echo "Install with: brew install sqlite3 openssl jq"
        exit 1
    fi
}

# Verify bundle structure
verify_bundle_structure() {
    local bundle_path="$1"
    
    print_status "Verifying bundle structure..."
    
    # Check required files
    local required_files=("manifest.json" "evidence_chain.json")
    local missing_files=()
    
    for file in "${required_files[@]}"; do
        if [ ! -f "$bundle_path/$file" ]; then
            missing_files+=("$file")
        fi
    done
    
    if [ ${#missing_files[@]} -gt 0 ]; then
        add_step "bundle_structure" "FAIL" "Missing required files: ${missing_files[*]}"
        return 1
    fi
    
    # Verify JSON validity
    if ! jq empty "$bundle_path/manifest.json" 2>/dev/null; then
        add_step "bundle_structure" "FAIL" "Invalid JSON in manifest.json"
        return 1
    fi
    
    if ! jq empty "$bundle_path/evidence_chain.json" 2>/dev/null; then
        add_step "bundle_structure" "FAIL" "Invalid JSON in evidence_chain.json"
        return 1
    fi
    
    add_step "bundle_structure" "PASS" "Bundle structure is valid"
    return 0
}

# Verify bundle integrity
verify_bundle_integrity() {
    local bundle_path="$1"
    
    print_status "Verifying bundle integrity..."
    
    # Extract expected hash from manifest
    local expected_bundle_hash
    expected_bundle_hash=$(jq -r '.bundle_hash // empty' "$bundle_path/manifest.json")
    
    if [ -z "$expected_bundle_hash" ] || [ "$expected_bundle_hash" = "null" ]; then
        add_step "bundle_integrity" "WARN" "No bundle hash found in manifest"
        return 1
    fi
    
    # Calculate actual bundle hash
    local actual_bundle_hash
    actual_bundle_hash=$(find "$bundle_path" -type f -exec sha256sum {} \; | sort | sha256sum | cut -d' ' -f1)
    
    if [ "$expected_bundle_hash" = "$actual_bundle_hash" ]; then
        add_step "bundle_integrity" "PASS" "Bundle integrity verified"
    else
        add_step "bundle_integrity" "FAIL" "Bundle hash mismatch: expected $expected_bundle_hash, got $actual_bundle_hash"
        return 1
    fi
}

# Verify evidence chain
verify_evidence_chain() {
    local bundle_path="$1"
    
    print_status "Verifying evidence chain..."
    
    # Check if evidence chain file exists
    if [ ! -f "$bundle_path/evidence_chain.json" ]; then
        add_step "evidence_chain" "WARN" "No evidence chain file found"
        return 0
    fi
    
    # Create temporary database for chain verification
    local temp_db
    temp_db=$(mktemp)
    trap "rm -f $temp_db" EXIT
    
    # Create evidence chain table
    sqlite3 "$temp_db" <<EOF
CREATE TABLE evidence_chain (
    sequence_number INTEGER PRIMARY KEY,
    event_id TEXT NOT NULL,
    event_type TEXT NOT NULL,
    timestamp INTEGER NOT NULL,
    payload_hash TEXT NOT NULL,
    previous_hash TEXT NOT NULL,
    head_hash TEXT NOT NULL
);
EOF
    
    # Import evidence chain
    local import_errors=0
    jq -r '.[] | [.sequence_number // 0, .event_id, .event_type, .timestamp, .payload_hash, .previous_hash, .head_hash] | @tsv' "$bundle_path/evidence_chain.json" | while IFS=$'\t' read -r seq_id event_id event_type timestamp payload_hash prev_hash head_hash; do
        if [ -n "$event_id" ]; then
            sqlite3 "$temp_db" "INSERT INTO evidence_chain VALUES ($seq_id, '$event_id', '$event_type', $timestamp, '$payload_hash', '$prev_hash', '$head_hash');" 2>/dev/null || import_errors=$((import_errors + 1))
        fi
    done
    
    if [ $import_errors -gt 0 ]; then
        add_step "evidence_chain" "FAIL" "Failed to import $import_errors evidence chain entries"
        return 1
    fi
    
    # Verify chain linkage
    local chain_violations=0
    local previous_head_hash=""
    
    while IFS='|' read -r seq_id event_id event_type timestamp payload_hash prev_hash head_hash; do
        if [ "$prev_hash" != "$previous_head_hash" ] && [ -n "$previous_head_hash" ]; then
            chain_violations=$((chain_violations + 1))
            echo "Chain break at event $event_id: previous=$prev_hash, expected=$previous_head_hash" >&2
        fi
        previous_head_hash="$head_hash"
    done < <(sqlite3 "$temp_db" "SELECT sequence_number, event_id, event_type, timestamp, payload_hash, previous_hash, head_hash FROM evidence_chain ORDER BY sequence_number;" | tr '\t' '|')
    
    if [ $chain_violations -eq 0 ]; then
        local total_events
        total_events=$(sqlite3 "$temp_db" "SELECT COUNT(*) FROM evidence_chain;")
        add_step "evidence_chain" "PASS" "Evidence chain verified ($total_events events)"
    else
        add_step "evidence_chain" "FAIL" "Evidence chain has $chain_violations violations"
        return 1
    fi
}

# Verify digital signatures
verify_digital_signatures() {
    local bundle_path="$1"
    
    print_status "Verifying digital signatures..."
    
    # Check for signature file
    if [ ! -f "$bundle_path/signature.json" ]; then
        add_step "digital_signatures" "WARN" "No digital signature found"
        return 0
    fi
    
    # Extract signature data
    local signature_data
    signature_data=$(jq -r '.signature_data // empty' "$bundle_path/signature.json")
    
    if [ -z "$signature_data" ] || [ "$signature_data" = "null" ]; then
        add_step "digital_signatures" "FAIL" "Invalid signature format"
        return 1
    fi
    
    # Extract signed data (manifest without signature field)
    local manifest_without_signature
    manifest_without_signature=$(jq 'del(.signature_data)' "$bundle_path/manifest.json")
    
    # Create temporary files for verification
    local manifest_file
    local signature_file
    manifest_file=$(mktemp)
    signature_file=$(mktemp)
    
    trap "rm -f $manifest_file $signature_file" EXIT
    
    echo "$manifest_without_signature" > "$manifest_file"
    echo -n "$signature_data" | base64 -d > "$signature_file"
    
    # Check if public key is available
    if [ ! -f "$bundle_path/public_key.pem" ]; then
        add_step "digital_signatures" "WARN" "No public key available for signature verification"
        return 0
    fi
    
    # Verify signature
    if openssl dgst -sha256 -verify "$bundle_path/public_key.pem" -signature "$signature_file" "$manifest_file" 2>/dev/null; then
        add_step "digital_signatures" "PASS" "Digital signature verified"
    else
        add_step "digital_signatures" "FAIL" "Digital signature verification failed"
        return 1
    fi
}

# Verify timestamp tokens
verify_timestamp_tokens() {
    local bundle_path="$1"
    
    if [ "$SKIP_TIMESTAMPS" = true ]; then
        add_step "timestamp_tokens" "SKIP" "Timestamp verification skipped"
        return 0
    fi
    
    print_status "Verifying timestamp tokens..."
    
    # Check for timestamp file
    if [ ! -f "$bundle_path/timestamp.json" ]; then
        add_step "timestamp_tokens" "WARN" "No timestamp token found"
        return 0
    fi
    
    # Extract timestamp data
    local timestamp_type
    timestamp_type=$(jq -r '.type // empty' "$bundle_path/timestamp.json")
    
    case "$timestamp_type" in
        "rfc3161")
            verify_rfc3161_timestamp "$bundle_path"
            ;;
        "nist_beacon")
            verify_nist_beacon_timestamp "$bundle_path"
            ;;
        "blockchain")
            verify_blockchain_timestamp "$bundle_path"
            ;;
        *)
            add_step "timestamp_tokens" "WARN" "Unknown timestamp type: $timestamp_type"
            ;;
    esac
}

# Verify RFC3161 timestamp
verify_rfc3161_timestamp() {
    local bundle_path="$1"
    
    # Extract timestamp token
    local timestamp_token
    timestamp_token=$(jq -r '.timestamp_token // empty' "$bundle_path/timestamp.json")
    
    if [ -z "$timestamp_token" ] || [ "$timestamp_token" = "null" ]; then
        add_step "rfc3161_timestamp" "FAIL" "No RFC3161 timestamp token found"
        return 1
    fi
    
    # Decode base64 token
    local token_file
    token_file=$(mktemp)
    trap "rm -f $token_file" EXIT
    
    echo -n "$timestamp_token" | base64 -d > "$token_file"
    
    # Basic token validation (simplified)
    if openssl asn1parse -inform DER -in "$token_file" >/dev/null 2>&1; then
        add_step "rfc3161_timestamp" "PASS" "RFC3161 timestamp token format is valid"
    else
        add_step "rfc3161_timestamp" "FAIL" "Invalid RFC3161 timestamp token format"
        return 1
    fi
}

# Verify NIST Randomness Beacon timestamp
verify_nist_beacon_timestamp() {
    local bundle_path="$1"
    
    # Extract beacon data
    local beacon_value
    local beacon_timestamp
    beacon_value=$(jq -r '.beacon_value // empty' "$bundle_path/timestamp.json")
    beacon_timestamp=$(jq -r '.beacon_timestamp // empty' "$bundle_path/timestamp.json")
    
    if [ -z "$beacon_value" ] || [ "$beacon_value" = "null" ]; then
        add_step "nist_beacon_timestamp" "FAIL" "No NIST Beacon data found"
        return 1
    fi
    
    # Basic validation (simplified - in real implementation would verify against NIST API)
    if [ ${#beacon_value} -eq 64 ] && [ "$beacon_timestamp" -gt 0 ]; then
        add_step "nist_beacon_timestamp" "PASS" "NIST Beacon timestamp format is valid"
    else
        add_step "nist_beacon_timestamp" "WARN" "NIST Beacon timestamp format may be invalid"
    fi
}

# Verify blockchain timestamp
verify_blockchain_timestamp() {
    local bundle_path="$1"
    
    # Extract blockchain data
    local transaction_hash
    local block_height
    transaction_hash=$(jq -r '.transaction_hash // empty' "$bundle_path/timestamp.json")
    block_height=$(jq -r '.block_height // empty' "$bundle_path/timestamp.json")
    
    if [ -z "$transaction_hash" ] || [ "$transaction_hash" = "null" ]; then
        add_step "blockchain_timestamp" "FAIL" "No blockchain timestamp data found"
        return 1
    fi
    
    # Basic validation
    if [ ${#transaction_hash} -eq 64 ] && [ "$block_height" -gt 0 ]; then
        add_step "blockchain_timestamp" "WARN" "Blockchain timestamp format is valid (offline verification limited)"
    else
        add_step "blockchain_timestamp" "WARN" "Blockchain timestamp format may be invalid"
    fi
}

# Verify key custody and revocation
verify_key_custody() {
    local bundle_path="$1"
    
    print_status "Verifying key custody..."
    
    # Check for key metadata
    if [ ! -f "$bundle_path/key_metadata.json" ]; then
        add_step "key_custody" "WARN" "No key metadata found"
        return 0
    fi
    
    # Extract key information
    local key_fingerprint
    local key_status
    local created_at
    key_fingerprint=$(jq -r '.fingerprint // empty' "$bundle_path/key_metadata.json")
    key_status=$(jq -r '.status // empty' "$bundle_path/key_metadata.json")
    created_at=$(jq -r '.created // empty' "$bundle_path/key_metadata.json")
    
    if [ -z "$key_fingerprint" ] || [ "$key_fingerprint" = "null" ]; then
        add_step "key_custody" "FAIL" "No key fingerprint found"
        return 1
    fi
    
    # Check key status
    if [ "$key_status" = "active" ]; then
        add_step "key_custody" "PASS" "Key is active and valid"
    elif [ "$key_status" = "revoked" ]; then
        add_step "key_custody" "FAIL" "Key was revoked"
        return 1
    elif [ "$key_status" = "deprecated" ]; then
        add_step "key_custody" "WARN" "Key is deprecated"
    else
        add_step "key_custody" "WARN" "Unknown key status: $key_status"
    fi
    
    # Check revocation list if provided
    if [ -n "$REVOCATION_LIST" ] && [ -f "$REVOCATION_LIST" ]; then
        if grep -q "$key_fingerprint" "$REVOCATION_LIST"; then
            add_step "key_custody" "FAIL" "Key found in revocation list"
            return 1
        else
            add_step "key_custody" "PASS" "Key not found in revocation list"
        fi
    fi
}

# Verify hardware attestations
verify_hardware_attestations() {
    local bundle_path="$1"
    
    if [ "$SKIP_ATTESTATIONS" = true ]; then
        add_step "hardware_attestations" "SKIP" "Hardware attestation verification skipped"
        return 0
    fi
    
    print_status "Verifying hardware attestations..."
    
    # Check for attestation file
    if [ ! -f "$bundle_path/hardware_attestation.json" ]; then
        add_step "hardware_attestations" "WARN" "No hardware attestation found"
        return 0
    fi
    
    # Extract attestation data
    local device_uuid
    local secure_enclave_id
    local signature_data
    device_uuid=$(jq -r '.device_uuid // empty' "$bundle_path/hardware_attestation.json")
    secure_enclave_id=$(jq -r '.secure_enclave_id // empty' "$bundle_path/hardware_attestation.json")
    signature_data=$(jq -r '.signature_data // empty' "$bundle_path/hardware_attestation.json")
    
    # Basic validation
    if [ -n "$device_uuid" ] && [ -n "$secure_enclave_id" ] && [ -n "$signature_data" ]; then
        add_step "hardware_attestations" "PASS" "Hardware attestation format is valid"
    else
        add_step "hardware_attestations" "WARN" "Hardware attestation may be incomplete"
    fi
}

# Verify redaction audit trail
verify_redaction_audit() {
    local bundle_path="$1"
    
    print_status "Verifying redaction audit trail..."
    
    # Check if this is a redacted bundle
    local is_redacted
    is_redacted=$(jq -r '.redacted_bundle_id // empty' "$bundle_path/manifest.json")
    
    if [ -z "$is_redacted" ] || [ "$is_redacted" = "null" ]; then
        add_step "redaction_audit" "SKIP" "Not a redacted bundle"
        return 0
    fi
    
    # Check for redaction audit trail
    if [ ! -f "$bundle_path/redaction_audit.json" ]; then
        add_step "redaction_audit" "FAIL" "Redacted bundle missing audit trail"
        return 1
    fi
    
    # Extract audit information
    local original_bundle_id
    local total_redactions
    local privilege_log_entries
    original_bundle_id=$(jq -r '.original_bundle_id // empty' "$bundle_path/redaction_audit.json")
    total_redactions=$(jq -r '.total_redactions // 0' "$bundle_path/redaction_audit.json")
    privilege_log_entries=$(jq -r '.privilege_log_entries // 0' "$bundle_path/redaction_audit.json")
    
    if [ -n "$original_bundle_id" ] && [ "$total_redactions" -ge 0 ]; then
        add_step "redaction_audit" "PASS" "Redaction audit trail verified ($total_redactions redactions, $privilege_log_entries privilege entries)"
    else
        add_step "redaction_audit" "FAIL" "Invalid redaction audit trail"
        return 1
    fi
}

# Generate verification report
generate_report() {
    local bundle_path="$1"
    local output_file="$2"
    local format="$3"
    
    print_status "Generating verification report..."
    
    local bundle_id
    bundle_id=$(jq -r '.bundle_id // "unknown"' "$bundle_path/manifest.json")
    
    local created_at
    created_at=$(jq -r '.created_at // "unknown"' "$bundle_path/manifest.json")
    
    # Create report header
    local report_content="ANIGMA OFFLINE VERIFICATION REPORT
========================================

Bundle ID: $bundle_id
Bundle Path: $bundle_path
Verified At: $(date)
Verification Version: $VERIFICATION_VERSION
Created At: $created_at

OVERALL RESULT: $([ "$VERIFICATION_PASSED" = true ] && echo "PASSED" || echo "FAILED")

SUMMARY:
- Verification Steps: ${#VERIFICATION_STEPS[@]}
- Warnings: $VERIFICATION_WARNINGS
- Errors: $VERIFICATION_ERRORS

DETAILED RESULTS:
"

    # Add detailed steps
    for step in "${VERIFICATION_STEPS[@]}"; do
        IFS='|' read -r name result message <<< "$step"
        local status_symbol=""
        case "$result" in
            "PASS") status_symbol="✅" ;;
            "WARN") status_symbol="⚠️ " ;;
            "FAIL") status_symbol="❌" ;;
            "SKIP") status_symbol="⏭️ " ;;
        esac
        report_content+="$status_symbol $name: $message
"
    done
    
    # Add bundle information
    report_content+="

BUNDLE INFORMATION:
"
    jq -r 'to_entries[] | "\(.key): \(.value)"' "$bundle_path/manifest.json" | while read -r line; do
        report_content+="$line
"
    done
    
    # Write report
    case "$format" in
        "json")
            local json_report
            json_report=$(jq -n \
                --arg bundle_id "$bundle_id" \
                --arg bundle_path "$bundle_path" \
                --arg verified_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
                --argjson passed "$VERIFICATION_PASSED" \
                --argjson warnings "$VERIFICATION_WARNINGS" \
                --argjson errors "$VERIFICATION_ERRORS" \
                --argjson steps "$(printf '%s\n' "${VERIFICATION_STEPS[@]}" | jq -R . | jq -s .)" \
                '{
                    bundle_id: $bundle_id,
                    bundle_path: $bundle_path,
                    verified_at: $verified_at,
                    verification_version: $VERIFICATION_VERSION,
                    overall_result: $passed,
                    summary: {
                        total_steps: ($steps | length),
                        warnings: $warnings,
                        errors: $errors
                    },
                    detailed_steps: $steps
                }')
            echo "$json_report" > "$output_file"
            ;;
        "html")
            cat > "$output_file" <<HTML
<!DOCTYPE html>
<html>
<head>
    <title>Anigma Verification Report</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 40px; }
        .header { background: #f0f0f0; padding: 20px; border-radius: 5px; }
        .passed { color: green; font-weight: bold; }
        .failed { color: red; font-weight: bold; }
        .warning { color: orange; font-weight: bold; }
        .steps { margin: 20px 0; }
        .step { margin: 10px 0; padding: 10px; border-left: 3px solid #ccc; }
        .pass { border-left-color: green; }
        .warn { border-left-color: orange; }
        .fail { border-left-color: red; }
        pre { background: #f5f5f5; padding: 10px; border-radius: 3px; }
    </style>
</head>
<body>
    <div class="header">
        <h1>Anigma Offline Verification Report</h1>
        <p>Bundle ID: $bundle_id</p>
        <p>Verified: $(date)</p>
        <p class="$([ "$VERIFICATION_PASSED" = true ] && echo "passed" || echo "failed")">
            Overall Result: $([ "$VERIFICATION_PASSED" = true ] && echo "PASSED" || echo "FAILED")
        </p>
    </div>
    
    <div class="summary">
        <h2>Summary</h2>
        <p>Steps: ${#VERIFICATION_STEPS[@]}</p>
        <p>Warnings: $VERIFICATION_WARNINGS</p>
        <p>Errors: $VERIFICATION_ERRORS</p>
    </div>
    
    <div class="steps">
        <h2>Detailed Results</h2>
HTML

            for step in "${VERIFICATION_STEPS[@]}"; do
                IFS='|' read -r name result message <<< "$step"
                local css_class=""
                case "$result" in
                    "PASS") css_class="pass" ;;
                    "WARN") css_class="warn" ;;
                    "FAIL") css_class="fail" ;;
                esac
                echo "        <div class=\"step $css_class\">"
                echo "            <strong>$name:</strong> $message"
                echo "        </div>"
            done

            cat >> "$output_file" <<HTML
    </div>
    
    <div class="bundle-info">
        <h2>Bundle Information</h2>
        <pre>$(jq -r . "$bundle_path/manifest.json")</pre>
    </div>
</body>
</html>
HTML
            ;;
        *)
            echo "$report_content" > "$output_file"
            ;;
    esac
    
    print_success "Verification report saved to: $output_file"
}

# Main verification function
verify_bundle() {
    local bundle_path="$1"
    
    # Initialize verification
    VERIFICATION_PASSED=true
    VERIFICATION_WARNINGS=0
    VERIFICATION_ERRORS=0
    VERIFICATION_STEPS=()
    
    print_status "Starting offline verification of: $bundle_path"
    
    # Run all verification steps
    verify_bundle_structure "$bundle_path"
    verify_bundle_integrity "$bundle_path"
    verify_evidence_chain "$bundle_path"
    verify_digital_signatures "$bundle_path"
    verify_timestamp_tokens "$bundle_path"
    verify_key_custody "$bundle_path"
    verify_hardware_attestations "$bundle_path"
    verify_redaction_audit "$bundle_path"
    
    # Show final result
    echo ""
    if [ "$VERIFICATION_PASSED" = true ]; then
        print_success "🎉 VERIFICATION PASSED"
    else
        print_error "❌ VERIFICATION FAILED"
    fi
    
    echo "Summary: ${#VERIFICATION_STEPS[@]} steps, $VERIFICATION_WARNINGS warnings, $VERIFICATION_ERRORS errors"
    
    # Generate report if requested
    if [ -n "$OUTPUT_FILE" ]; then
        generate_report "$bundle_path" "$OUTPUT_FILE" "$FORMAT"
    fi
}

# Main script execution
main() {
    # Parse command line arguments
    STRICT_MODE=false
    SKIP_TIMESTAMPS=false
    SKIP_ATTESTATIONS=false
    REVOCATION_LIST=""
    TRUST_ANCHORS=""
    OUTPUT_FILE=""
    FORMAT="txt"
    VERBOSE=false
    QUIET=false
    
    while [[ $# -gt 0 ]]; do
        case $1 in
            --strict)
                STRICT_MODE=true
                shift
                ;;
            --skip-timestamps)
                SKIP_TIMESTAMPS=true
                shift
                ;;
            --skip-attestations)
                SKIP_ATTESTATIONS=true
                shift
                ;;
            --revocation-list)
                REVOCATION_LIST="$2"
                shift 2
                ;;
            --trust-anchors)
                TRUST_ANCHORS="$2"
                shift 2
                ;;
            --output)
                OUTPUT_FILE="$2"
                shift 2
                ;;
            --format)
                FORMAT="$2"
                shift 2
                ;;
            --verbose)
                VERBOSE=true
                shift
                ;;
            --quiet)
                QUIET=true
                shift
                ;;
            -*)
                print_error "Unknown option: $1"
                show_help
                exit 1
                ;;
            *)
                BUNDLE_PATH="$1"
                shift
                ;;
        esac
    done
    
    # Check arguments
    if [ -z "$BUNDLE_PATH" ]; then
        print_error "Bundle path required"
        show_help
        exit 1
    fi
    
    if [ ! -d "$BUNDLE_PATH" ]; then
        print_error "Bundle directory not found: $BUNDLE_PATH"
        exit 1
    fi
    
    # Show header unless quiet
    if [ "$QUIET" = false ]; then
        print_header
    fi
    
    # Check dependencies
    check_dependencies
    
    # Run verification
    verify_bundle "$BUNDLE_PATH"
    
    # Exit with appropriate code
    if [ "$VERIFICATION_PASSED" = true ]; then
        exit 0
    else
        exit 1
    fi
}

# Run main function with all arguments
main "$@"