// color_conversion.golden
// sRGB -> Linear -> HSL
sRGB(0.0, 0.0, 0.0) -> Linear(0.000000, 0.000000, 0.000000) -> HSL(0.000000, 0.000000, 0.000000)
sRGB(1.0, 1.0, 1.0) -> Linear(1.000000, 1.000000, 1.000000) -> HSL(0.000000, 0.000000, 1.000000)
sRGB(0.5, 0.5, 0.5) -> Linear(0.214041, 0.214041, 0.214041) -> HSL(0.000000, 0.000000, 0.500000)
sRGB(1.0, 0.0, 0.0) -> Linear(1.000000, 0.000000, 0.000000) -> HSL(0.000000, 1.000000, 0.500000)
sRGB(0.0, 1.0, 0.0) -> Linear(0.000000, 1.000000, 0.000000) -> HSL(0.333333, 1.000000, 0.500000)
sRGB(0.0, 0.0, 1.0) -> Linear(0.000000, 0.000000, 1.000000) -> HSL(0.666667, 1.000000, 0.500000)
