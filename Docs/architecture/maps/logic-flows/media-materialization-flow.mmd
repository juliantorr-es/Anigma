%% - Sources/MediaCore/Governance/SurfaceAuthority.swift (authority)
%% - Sources/MediaCore/Governance/MaterializationGate.swift (gate)
%% - Sources/MediaCore/Executors/*Executor.swift (executors using surfaces)
